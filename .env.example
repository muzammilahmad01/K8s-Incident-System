# Copy to .env and fill in. .env is gitignored.

# --- LLM backend: groq (default) | openai | ollama ---
LLM_BACKEND=groq

# Groq (free tier). Get a key at https://console.groq.com/keys
# GPT-OSS models support strict structured output (needed by the reason node).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI (optional alternative)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Ollama (optional local fallback)
# OLLAMA_MODEL=llama3
# OLLAMA_BASE_URL=http://localhost:11434

# --- Prometheus / Alertmanager (port-forward these from kind locally) ---
ALERTMANAGER_URL=http://localhost:9093
PROMETHEUS_URL=http://localhost:9090
POLL_INTERVAL_SECONDS=60

# --- Kubernetes ---
IN_CLUSTER=false
DEFAULT_NAMESPACE=default

# --- Vector store ---
CHROMA_PERSIST_DIR=./.chroma
RUNBOOK_DIR=./runbooks
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3

# --- Safety (FR-5) ---
ENABLE_AUTO_REMEDIATION=true

# --- Output ---
REPORT_LOG_PATH=./incident-reports.jsonl
